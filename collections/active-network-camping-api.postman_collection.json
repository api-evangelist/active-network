                  "description": "Latitude for a 200-mile radius geographic search."
                },
                {
                  "disabled": false,
                  "key": "landmarkLong",
                  "value": "<number>",
                  "description": "Longitude for a 200-mile radius geographic search."
                },
                {
                  "disabled": false,
                  "key": "landmarkName",
                  "value": "<string>",
                  "description": "Set to \"true\" when providing landmark coordinates."
