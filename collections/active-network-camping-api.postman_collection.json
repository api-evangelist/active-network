          "name": "Search campgrounds",
          "request": {
            "name": "Search campgrounds",
            "description": {
              "content": "Search campgrounds by state, park name, site type, amenities, hookup requirements, and landmark radius. Returns an XML list of facilities with amenity indicators.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "camping",
                "campgrounds"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "<string>",
                  "description": "(Required) API key obtained via developer registration."
                },
                {
                  "disabled": false,
                  "key": "pstate",
                  "value": "<string>",
                  "description": "2-character US state or Canadian province code."
                },
                {
                  "disabled": false,
                  "key": "pname",
                  "value": "<string>",
                  "description": "Park name search string (for example \"ASPEN\")."
                },
                {
                  "disabled": false,
                  "key": "siteType",
                  "value": "<integer>",
                  "description": "Accommodation type code (2001 RV, 10001 Cabin, 2003 Tent, 2002 Trailer, 9002 Group, 9001 Day Use, 3001 Horse, 2004 Boat)."
                },
                {
                  "disabled": false,
                  "key": "amenity",
                  "value": "<integer>",
                  "description": "Recreation activity code (4001 Biking, 4004 Fishing, 4005 Golf, 4006 Hiking, 4007 Horseback, 4008 Hunting, 4013 Winter)."
                },
                {
                  "disabled": false,
                  "key": "eqplen",
                  "value": "<integer>",
                  "description": "RV length in feet."
                },
                {
                  "disabled": false,
                  "key": "maxpeople",
                  "value": "<integer>",
                  "description": "Occupancy limit."
                },
                {
                  "disabled": false,
                  "key": "hookup",
                  "value": "<integer>",
                  "description": "Electric hookup code (3002 15A+, 3003 20A+, 3004 30A+, 3005 50A+)."
                },
                {
                  "disabled": false,
                  "key": "water",
                  "value": "<integer>",
                  "description": "Water hookup code (3006 or 3007)."
                },
                {
                  "disabled": false,
                  "key": "sewer",
                  "value": "<integer>",
                  "description": "Sewer hookup code (3007)."
                },
                {
                  "disabled": false,
                  "key": "pull",
